{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git push origin HEAD:main 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Pushing to main..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git push origin HEAD:main)"
    ]
  }
}
